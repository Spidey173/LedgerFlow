# AWS Cloud Configuration
# Note: Do not commit actual cloud credentials to version control.
# Set these in your execution environment or CI/CD secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=ledgerflow-banking-example

# Database Configuration (PostgreSQL / Neon Cloud / Local Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bank_dwh
DB_USER=postgres
DB_PASSWORD=

# Optional direct connection URI (takes precedence over DB_* if set)
# DATABASE_URL=postgresql://user:password@localhost:5432/bank_dwh

# API Configuration & Security
# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins. Never use '*' in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://ledgerflow17.vercel.app

# API Authentication & RBAC (Bearer Tokens)
# In production / cloud deployments, set API_AUTH_ENABLED=true and provide secure, high-entropy tokens.
# Format: <token_or_secret>:<role> (Roles: read_only, analyst, admin)
# Example: prod-read-key_c8f39b...:read_only,prod-analyst-key_d1a24e...:analyst,prod-admin-key_f93e1b...:admin
# For enterprise production, integrate with OAuth2/OIDC provider (e.g. AWS Cognito, Auth0, Keycloak).
API_AUTH_ENABLED=true
API_KEYS=

# Execution Mode: Set to true only for offline/demo/sandbox UI preview without database connection
# In production, keep DEMO_MODE=false so that database errors fail visibly with HTTP 503 instead of masking outages.
DEMO_MODE=false

# Ingestion Secret Key (for encrypted ZIP payload)
# In production, this is fetched dynamically from AWS SSM Parameter Store (/ledgerflow/zip_password)
ZIP_DECRYPTION_PASSWORD=
